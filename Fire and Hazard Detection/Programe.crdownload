import os

model_path = "/content/runs/detect/train/weights/best.pt"

if os.path.exists(model_path):
    size_mb = os.path.getsize(model_path) / (1024 * 1024)
    print("✅ best.pt found!")
    print("Path:", model_path)
    print(f"Size: {size_mb:.2f} MB")
else:
